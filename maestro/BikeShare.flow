# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

# Countries, networks and stations come from the live CityBikes API, so allow for a slow network.
# The first load is the slowest: the app fetches the whole network list (retrying on failure)
# before any country shows, and shows "Could not load bike networks" if every attempt fails.
- scrollUntilVisible:
    element: "Ireland"
    timeout: 90000
- tapOn: "Ireland"

- extendedWaitUntil:
    visible: "Galway"
    timeout: 30000
- tapOn: "Galway"

- extendedWaitUntil:
    visible: "Available Bikes"
    timeout: 30000
- takeScreenshot: BikeShare
